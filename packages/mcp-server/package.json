{
  "name": "@susaplay/mcp",
  "version": "0.3.1",
  "description": "MCP server for SusaPlay: check Unity projects, inspect and publish WebGL builds, and read games and analytics from an AI coding assistant",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "susaplay",
    "unity",
    "webgl",
    "addressables"
  ],
  "homepage": "https://github.com/Susa-Games/susaplay-ai/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Susa-Games/susaplay-ai/issues"
  },
  "type": "module",
  "bin": {
    "susaplay-mcp": "dist/susaplay-mcp.mjs"
  },
  "files": [
    "dist/susaplay-mcp.mjs",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"for (const f of ['LICENSE', 'NOTICE']) require('fs').copyFileSync('../../' + f, f)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Susa-Games/susaplay-ai.git",
    "directory": "packages/mcp-server"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
