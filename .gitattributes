# No pattern here may match plugins/: Anthropic's plugin directory refuses a plugin whose
# files any .gitattributes rule applies to, since a checkout could rewrite them. The plugin is
# committed with LF and installed byte for byte.
/packages/** text=auto eol=lf
/.github/** text=auto eol=lf
/.claude-plugin/** text=auto eol=lf
/.cursor-plugin/** text=auto eol=lf
/*.md text=auto eol=lf
/*.json text=auto eol=lf
/LICENSE text=auto eol=lf
/NOTICE text=auto eol=lf
/.gitignore text=auto eol=lf
# Unity output used as test fixtures: byte for byte as Unity wrote it.
/packages/**/*.bin binary
/packages/**/*.bundle binary
/packages/**/*.png binary
